{
  "name": "dotrace-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Agentive Client AI bot for Dot Race (Vector Rally). Connects over WebSocket, parses host-authoritative game state, and drives an algorithmic pathfinder.",
  "type": "module",
  "main": "src/bot.ts",
  "scripts": {
    "start": "tsx src/bot.ts",
    "dev": "tsx watch src/bot.ts",
    "typecheck": "tsc --noEmit",
    "mock-server": "tsx test/mock-server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
