# Copy to bot/.env and adjust for your environment.

# WebSocket endpoint of the Dot Race game server.
# Local mock server (see `npm run mock-server`):
WS_URL=ws://localhost:8080/game
# Production API Gateway example:
# WS_URL=wss://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Code of the room the bot should join. A human (or another client) must host
# the room and approve the bot from the lobby. Required.
ROOM_CODE=ABCDE

# Display name the bot uses in the lobby.
NICKNAME=RoboRacer

# Milliseconds the bot "thinks" before submitting a move (human-ish pacing).
MOVE_DELAY_MS=250

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
