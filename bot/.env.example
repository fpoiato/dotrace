# Copy this file to .env and fill in the values, or export them as shell vars.
# Usage: ROOM_CODE=ABCDE npm start

# WebSocket server URL (required)
WS_URL=ws://localhost:8080/game

# 5-letter room code shown in the lobby (required)
ROOM_CODE=ABCDE

# Bot's display name in the player list
NICKNAME=RacerBot

# Milliseconds to wait between receiving a turn signal and sending the move.
# Increase to make the bot "think" more visibly; set to 0 for instant moves.
MOVE_DELAY_MS=500
