{
  "name": "dotrace-game",
  "private": true,
  "workspaces": [
    "bot",
    "frontend/dotrace-app",
    "infra/cdk"
  ],
  "scripts": {
    "bot": "npm --workspace=bot run start --",
    "bot:check": "npm --workspace=bot run check",
    "start": "npm run start --workspace=frontend/dotrace-app",
    "build": "npm run build --workspace=frontend/dotrace-app",
    "cdk:deploy": "npm run deploy --workspace=infra/cdk",
    "cdk:synth": "npm run synth --workspace=infra/cdk",
    "test": "npm run test --workspace=infra/cdk"
  }
}
